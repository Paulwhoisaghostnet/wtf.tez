# Network: "mainnet" or "ghostnet"
VITE_TEZOS_NETWORK=ghostnet

# WtfTezRegistrar contract address (deployed)
VITE_REGISTRAR_ADDRESS=

# Previous registrar contracts (comma-separated) — keeps activity feed continuous across upgrades
LEGACY_REGISTRARS=

# Pinata JWT for IPFS image pinning (profile avatars, project logos)
PINATA_JWT=

# Upstash Redis for signature replay protection (optional — degrades gracefully)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deploy scripts only (edsk... secret key — never expose client-side)
TEZOS_WALLET_PUB_KEY=

VITE_SITE_URL=https://wtftez.com

# Chat backend URL (CF Workers + PartyKit)
VITE_WTFCHAT_URL=http://localhost:8787
# Legacy alias supported by the app for hack.tez compatibility:
VITE_HACKCHAT_URL=
VITE_PARENT_DOMAIN_LABEL=wtf
VITE_CHAT_PARENT_DOMAINS=wtf,hack
VITE_CHAT_SIGNING_PREFIX=wtf.tez-chat

# PartyKit host for WebSocket connections
VITE_PARTYKIT_HOST=localhost:1999

# Wiki database (Neon Postgres — Netlify function)
DATABASE_URL=

# Shared JWT secret (must match chat worker CHAT_JWT_SECRET)
CHAT_JWT_SECRET=
CHAT_PARENT_DOMAINS=wtf,hack
CHAT_SIGNING_PREFIX=wtf.tez-chat
CHAT_ALLOWED_ORIGINS=https://wtftez.com,https://www.wtftez.com
